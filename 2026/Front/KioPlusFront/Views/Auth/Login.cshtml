@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutLogin";
}

<div class="kp-login-brand">KioPlus</div>

<div class="kp-login-box">
    <h1 class="kp-login-title">Iniciar Sesión</h1>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="NombreUsuario" class="form-label"></label>
            <input asp-for="NombreUsuario" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Contrasenia" class="form-label"></label>
            <input asp-for="Contrasenia" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Contrasenia" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-kp">Iniciar Sesión</button>

        <a class="kp-login-link" asp-action="RecuperarContrasenia">¿Olvidaste tu contraseña?</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
