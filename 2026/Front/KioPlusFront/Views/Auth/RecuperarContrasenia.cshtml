@model RecuperarContraseniaViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutLogin";
}

<div class="kp-login-brand">KioPlus</div>

<div class="kp-login-box">
    <h1 class="kp-login-title">Recuperar contraseña</h1>

    <form asp-action="RecuperarContrasenia" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="NombreUsuario" class="form-label"></label>
            <input asp-for="NombreUsuario" class="form-control" autocomplete="username" />
            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NuevaContrasenia" class="form-label"></label>
            <div class="kp-clave">
            <input asp-for="NuevaContrasenia" type="password" class="form-control" autocomplete="new-password" />
            <partial name="_OjoClave" model='"NuevaContrasenia"' />
        </div>
            <span asp-validation-for="NuevaContrasenia" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmacionContrasenia" class="form-label"></label>
            <div class="kp-clave">
            <input asp-for="ConfirmacionContrasenia" type="password" class="form-control" autocomplete="new-password" />
            <partial name="_OjoClave" model='"ConfirmacionContrasenia"' />
        </div>
            <span asp-validation-for="ConfirmacionContrasenia" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-kp w-100">Cambiar contraseña</button>
    </form>

    <a class="btn btn-kp-outline mt-3 w-100" asp-action="Login">Volver al inicio de sesión</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
