@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutLogin";
}

<div class="kp-login-brand">KioPlus</div>

<div class="kp-login-box">
    <h1 class="kp-login-title">Recuperar contraseña</h1>

    <p class="text-center text-muted">
        El sistema todavía no envía correos de recuperación.
        Pedile a un administrador que restablezca tu contraseña desde la pantalla de Usuarios.
    </p>

    <a class="btn btn-kp mt-3" asp-action="Login">Volver al inicio de sesión</a>
</div>
