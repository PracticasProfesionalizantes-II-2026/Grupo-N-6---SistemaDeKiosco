@model NuevaCompraViewModel
@{
    ViewData["Title"] = "Nueva compra";
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Nueva compra</h1>
    <a class="btn btn-kp-outline" asp-controller="Stock" asp-action="CrearProducto"
       asp-route-volverA="@Url.Action("Nueva", "Compras")">Nuevo Producto</a>
</div>

@* --- Alta de renglones: cada uno ingresa su propio lote --- *@
<form asp-action="AgregarItem" method="post" class="kp-filtros" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-6">
            <partial name="_Combo"
                     model="Combos.Productos(Model.Productos, Model.IdProductoNuevo, mostrarPrecio: false)" />
        </div>

        <div class="col-md-2">
            <label class="form-label" for="cantidad">Cantidad</label>
            <input class="form-control" type="number" id="cantidad" name="cantidad" min="1" value="1" required />
        </div>

        <div class="col-md-4">
            <label class="form-label" for="precioUnitario">Precio de compra</label>
            <input class="form-control" type="number" id="precioUnitario" name="precioUnitario"
                   step="0.01" min="0.01" required />
        </div>

        <div class="col-md-4">
            <label class="form-label" for="nroLote">N° de lote</label>
            <input class="form-control" id="nroLote" name="nroLote" placeholder="Opcional" />
        </div>

        <div class="col-md-4">
            <label class="form-label" for="fechaVencimiento">Vencimiento</label>
            <input class="form-control" type="date" id="fechaVencimiento" name="fechaVencimiento"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   data-msg-min="La fecha de vencimiento no puede ser anterior a hoy" />
        </div>

        <div class="col-md-4 d-flex align-items-start">
            <button type="submit" class="btn btn-kp w-100 mt-4">Agregar</button>
        </div>
    </div>
</form>

@* --- Renglones cargados --- *@
@if (Model.Items.Count == 0)
{
    <p class="kp-vacio">Todavía no cargaste productos en esta compra.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>N° de lote</th>
                    <th>Vencimiento</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio de compra</th>
                    <th class="text-end">Subtotal</th>
                    <th style="width:70px"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    <tr>
                        <td>@item.Producto</td>
                        <td>@(string.IsNullOrWhiteSpace(item.NroLote) ? "(se numera solo)" : item.NroLote)</td>
                        <td>@(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No vence")</td>
                        <td class="text-center">@item.Cantidad</td>
                        <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">$@item.Subtotal.ToString("N2")</td>
                        <td>
                            <form asp-action="QuitarItem" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="indice" value="@i" />
                                <button type="submit" class="kp-icon-btn" title="Quitar de la compra">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="m9 9 6 6M15 9l-6 6" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="kp-total">Total: $@Model.Total.ToString("N2")</div>
}

@* --- Cierre de la compra --- *@
<form asp-action="Finalizar" method="post" class="mt-4" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-md-8">
            <label asp-for="IdProveedor" class="form-label"></label>
            <select asp-for="IdProveedor" class="form-select">
                <option value="0">— Elegí el proveedor —</option>
                @foreach (var p in Model.Proveedores)
                {
                    <option value="@p.IdProveedor">@p.NombreRazonSocial</option>
                }
            </select>
            <span asp-validation-for="IdProveedor" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="FechaHora" class="form-label"></label>
            <input asp-for="FechaHora" type="date" class="form-control" />
            <span asp-validation-for="FechaHora" class="text-danger small"></span>
        </div>
    </div>

    <div class="kp-form-acciones">
        <button type="submit" class="btn btn-kp-outline" formaction="@Url.Action("Cancelar")">
            Cancelar compra
        </button>
        <button type="submit" class="btn btn-kp">Registrar compra</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
