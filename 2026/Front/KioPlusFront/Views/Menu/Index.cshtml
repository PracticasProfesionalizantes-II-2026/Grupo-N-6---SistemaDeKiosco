@using KioPlusFront.Models.Api
@using KioPlusFront.Services
@{
    ViewData["Title"] = "Menú";
    var avisos = ViewBag.CantidadAvisos as int? ?? 0;
    var avisosStock = ViewBag.AvisosStock as List<NotificacionDto> ?? new List<NotificacionDto>();
    var avisosVencimiento = ViewBag.AvisosVencimiento as List<NotificacionDto> ?? new List<NotificacionDto>();
    var saldoCaja = ViewBag.SaldoCaja as double?;
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Menú</h1>

    @if (avisos > 0)
    {
        <a class="btn btn-kp-outline" asp-controller="Notificaciones" asp-action="Index">
            @avisos aviso@(avisos == 1 ? "" : "s") pendiente@(avisos == 1 ? "" : "s")
        </a>
    }
</div>

@if (saldoCaja.HasValue)
{
    <div class="kp-caja">
        <span class="kp-caja-rotulo">Saldo de caja</span>
        <span class="kp-caja-monto">$@saldoCaja.Value.ToString("N2")</span>
    </div>
}

<div class="kp-cards">
    <a class="kp-card" asp-controller="Ventas" asp-action="Index">
        <span>Ventas</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 4h3l2.2 11.2a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.3L21 8H6" />
            <circle cx="10" cy="20" r="1.3" />
            <circle cx="18" cy="20" r="1.3" />
        </svg>
    </a>

    <a class="kp-card" asp-controller="Proveedores" asp-action="Index">
        <span>Proveedores</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 7h11v9H2z" />
            <path d="M13 10h4l3 3v3h-7z" />
            <circle cx="6.5" cy="18" r="1.4" />
            <circle cx="17" cy="18" r="1.4" />
        </svg>
    </a>

    <a class="kp-card" asp-controller="Stock" asp-action="Index">
        <span>Stock</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 7h18v12H3z" />
            <path d="M3 7l2-3h14l2 3" />
            <path d="M9.5 12h5" />
        </svg>
    </a>

    <a class="kp-card" asp-controller="CuentasCorrientes" asp-action="Index">
        <span>Cuenta corriente de cliente</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="5.5" width="19" height="13" rx="2" />
            <path d="M2.5 10h19" />
        </svg>
    </a>

    <a class="kp-card" asp-controller="Compras" asp-action="Index">
        <span>Compras</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h16l-1.3 12.2a1.5 1.5 0 0 1-1.5 1.3H6.8a1.5 1.5 0 0 1-1.5-1.3z" />
            <path d="M9 7V5.5a3 3 0 0 1 6 0V7" />
        </svg>
    </a>

    @* La gestión de usuarios es solo para administradores *@
    @if (Context.Session.ObtenerUsuario()?.EsAdministrador == true)
    {
        <a class="kp-card" asp-controller="Usuarios" asp-action="Index">
            <span>Usuarios</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8.5" r="3.5" />
                <path d="M5 20a7 7 0 0 1 14 0" />
            </svg>
        </a>
    }
</div>

@* Alertas automáticas: saltan al entrar al menú aunque no se consulten los listados *@
@if (avisosStock.Count > 0)
{
    <div class="modal fade" id="alerta-stock" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Alerta — Stock bajo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Hay @avisosStock.Count producto(s) con stock bajo:</p>
                    <ul class="mb-0">
                        @foreach (var aviso in avisosStock.Take(5))
                        {
                            <li>@aviso.Mensaje</li>
                        }
                    </ul>
                    @if (avisosStock.Count > 5)
                    {
                        <p class="form-text mb-0">y @(avisosStock.Count - 5) más.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-kp-outline" data-bs-dismiss="modal">Cerrar</button>
                    <a class="btn btn-kp" asp-controller="Stock" asp-action="Listado">Ir al listado de stock</a>
                </div>
            </div>
        </div>
    </div>
}

@if (avisosVencimiento.Count > 0)
{
    <div class="modal fade" id="alerta-vencimiento" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Alerta — Productos próximos a vencer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Hay @avisosVencimiento.Count lote(s) próximos a vencer:</p>
                    <ul class="mb-0">
                        @foreach (var aviso in avisosVencimiento.Take(5))
                        {
                            <li>@aviso.Mensaje</li>
                        }
                    </ul>
                    @if (avisosVencimiento.Count > 5)
                    {
                        <p class="form-text mb-0">y @(avisosVencimiento.Count - 5) más.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-kp-outline" data-bs-dismiss="modal">Cerrar</button>
                    <a class="btn btn-kp" asp-controller="Stock" asp-action="ProximosAVencer">Ir al listado</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Las alertas se muestran una vez por sesión del navegador: avisan sin
        // molestar cada vez que el usuario vuelve al menú.
        (function () {
            const alertas = ['alerta-stock', 'alerta-vencimiento'];

            for (const id of alertas) {
                const elemento = document.getElementById(id);
                if (!elemento) continue;

                let yaVisto = false;
                try { yaVisto = sessionStorage.getItem('kioplus.' + id) === '1'; } catch { }
                if (yaVisto) continue;

                try { sessionStorage.setItem('kioplus.' + id, '1'); } catch { }
                new bootstrap.Modal(elemento).show();
                break; // una alerta por vez: la otra queda en la pantalla de Avisos
            }
        })();
    </script>
}
