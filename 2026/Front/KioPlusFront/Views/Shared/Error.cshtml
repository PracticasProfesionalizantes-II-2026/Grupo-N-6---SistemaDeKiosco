@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_LayoutLogin";
}

<div class="kp-login-brand">KioPlus</div>

<div class="kp-login-box">
    <h1 class="kp-login-title">Ocurrió un error</h1>

    <p class="text-center text-muted">
        No pudimos procesar tu pedido. Volvé a intentarlo en unos segundos.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-center small text-muted">
            <strong>Código:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-kp mt-3" asp-controller="Menu" asp-action="Index">Volver al menú</a>
</div>
