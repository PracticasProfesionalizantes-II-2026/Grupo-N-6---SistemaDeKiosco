@using KioPlusFront.Services
@{
    var usuario = Context.Session.ObtenerUsuario();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string Activo(string nombre) =>
        controlador.Equals(nombre, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<nav class="kp-sidebar">
    <a class="kp-brand" asp-controller="Menu" asp-action="Index">KioPlus</a>

    <ul class="kp-nav">
        <li class="kp-nav-item">
            <a class="@Activo("Menu")" asp-controller="Menu" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9.5V20h14V9.5" />
                </svg>
                <span>Menú</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("Ventas")" asp-controller="Ventas" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 4h3l2.2 11.2a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.3L21 8H6" />
                    <circle cx="10" cy="20" r="1.3" />
                    <circle cx="18" cy="20" r="1.3" />
                </svg>
                <span>Ventas</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("Proveedores")" asp-controller="Proveedores" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 7h11v9H2z" />
                    <path d="M13 10h4l3 3v3h-7z" />
                    <circle cx="6.5" cy="18" r="1.4" />
                    <circle cx="17" cy="18" r="1.4" />
                </svg>
                <span>Proveedores</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("Compras")" asp-controller="Compras" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h16l-1.3 12.2a1.5 1.5 0 0 1-1.5 1.3H6.8a1.5 1.5 0 0 1-1.5-1.3z" />
                    <path d="M9 7V5.5a3 3 0 0 1 6 0V7" />
                </svg>
                <span>Compras</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("Stock")" asp-controller="Stock" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 7h18v12H3z" />
                    <path d="M3 7l2-3h14l2 3" />
                    <path d="M9.5 12h5" />
                </svg>
                <span>Stock</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("CuentasCorrientes")" asp-controller="CuentasCorrientes" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2.5" y="5.5" width="19" height="13" rx="2" />
                    <path d="M2.5 10h19" />
                </svg>
                <span>Cuenta corriente<br />de cliente</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8.5" r="3.5" />
                    <path d="M5 20a7 7 0 0 1 14 0" />
                </svg>
                <span>Usuarios</span>
            </a>
        </li>
        <li class="kp-nav-item">
            <a class="@Activo("Notificaciones")" asp-controller="Notificaciones" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 16V11a6 6 0 1 0-12 0v5l-1.5 2.5h15z" />
                    <path d="M10 20.5a2 2 0 0 0 4 0" />
                </svg>
                <span>Avisos</span>
            </a>
        </li>
    </ul>

    @if (usuario is not null)
    {
        <div class="kp-sidebar-footer">
            <div class="mb-1">@usuario.NombreApellido</div>
            <div class="mb-2">@usuario.TipoUsuario</div>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
            </form>
        </div>
    }
</nav>
