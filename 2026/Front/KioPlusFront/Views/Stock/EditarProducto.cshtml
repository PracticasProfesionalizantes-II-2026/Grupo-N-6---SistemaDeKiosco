@model ProductoFormViewModel
@{
    ViewData["Title"] = "Editar producto";
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Editar producto</h1>
</div>

<form asp-action="EditarProducto" method="post" class="kp-form">
    <partial name="_ProductoForm" model="Model" />

    <div class="kp-form-acciones">
        <a class="btn btn-kp-outline" asp-action="Productos">Cancelar</a>
        <button type="submit" class="btn btn-kp">Confirmar cambios</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
