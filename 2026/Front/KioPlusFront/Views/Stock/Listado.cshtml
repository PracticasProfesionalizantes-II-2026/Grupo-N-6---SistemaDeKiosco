@model IReadOnlyList<ProductoDto>
@{
    ViewData["Title"] = "Listado de stock";
    var criticos = ViewBag.Criticos as IReadOnlyList<StockCriticoDto> ?? Array.Empty<StockCriticoDto>();
    var nombresCriticos = criticos.Select(c => c.Nombre).ToHashSet();
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Listado de stock</h1>
    <a class="btn btn-kp-outline" asp-action="Index">Volver</a>
</div>

@if (criticos.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@criticos.Count producto@(criticos.Count == 1 ? "" : "s")</strong> con stock crítico:
        @string.Join(", ", criticos.Select(c => $"{c.Nombre} ({c.StockDisponible})"))
    </div>
}

@if (Model.Count == 0)
{
    <p class="kp-vacio">Todavía no hay productos cargados.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Marca</th>
                    <th class="text-center">Stock disponible</th>
                    <th class="text-end">Precio de venta</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.OrderBy(p => p.StockDisponible))
                {
                    var critico = nombresCriticos.Contains(p.Nombre);
                    <tr>
                        <td>@p.Nombre</td>
                        <td>@p.Marca</td>
                        <td class="text-center">@p.StockDisponible</td>
                        <td class="text-end">$@p.PrecioVenta.ToString("N2")</td>
                        <td class="text-center">
                            <span class="kp-badge @(critico ? "kp-badge-moroso" : "kp-badge-aldia")">
                                @(critico ? "Stock bajo" : "Normal")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
