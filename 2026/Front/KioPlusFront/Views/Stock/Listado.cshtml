@model IReadOnlyList<StockCriticoDto>
@{
    ViewData["Title"] = "Listado de stock";
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Listado de stock</h1>
    <a class="btn btn-kp-outline" asp-action="Index">Volver</a>
</div>

@if (Model.Count == 0)
{
    <p class="kp-vacio">Ningún producto está por debajo del stock mínimo.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Stock disponible</th>
                </tr>
            </thead>
            <tbody>
                @* Solo aparecen los productos con menos unidades que el mínimo *@
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.Nombre @producto.Marca</td>
                        <td class="text-center">
                            <span class="kp-badge kp-badge-moroso">@producto.StockDisponible</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
