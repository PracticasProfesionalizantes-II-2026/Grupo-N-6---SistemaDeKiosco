@model IReadOnlyList<ProximoVencimientoDto>
@{
    ViewData["Title"] = "Productos próximos a vencer";
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Productos próximos a vencer</h1>
    <a class="btn btn-kp-outline" asp-action="Index">Volver</a>
</div>

@if (Model.Count == 0)
{
    <p class="kp-vacio">No hay lotes próximos a vencer según los días de aviso configurados.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Nº de lote</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Días para vencer</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lote in Model.OrderBy(l => l.DiasParaQueVenza))
                {
                    <tr>
                        <td>@lote.Nombre</td>
                        <td>@lote.NroLote</td>
                        <td class="text-center">@lote.Cantidad</td>
                        <td class="text-center">
                            <span class="kp-badge @(lote.DiasParaQueVenza <= 3 ? "kp-badge-moroso" : "kp-badge-aldia")">
                                @(lote.DiasParaQueVenza == 0 ? "Vence hoy" : $"{lote.DiasParaQueVenza} día(s)")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
