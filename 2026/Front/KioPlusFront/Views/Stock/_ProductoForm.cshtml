@model ProductoFormViewModel
@*
    Campos compartidos por "Nuevo producto" y "Editar producto".
    El stock no se edita a mano: entra por compras y sale por ventas.
*@

@Html.AntiForgeryToken()
<input type="hidden" asp-for="IdProducto" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Marca" class="form-label"></label>
    <input asp-for="Marca" class="form-control" />
    <span asp-validation-for="Marca" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="IdCategoria" class="form-label"></label>
    <select asp-for="IdCategoria" class="form-select">
        <option value="0">— Elegí una categoría —</option>
        @foreach (var c in Model.Categorias)
        {
            <option value="@c.IdCategoria">@c.Nombre</option>
        }
    </select>
    <span asp-validation-for="IdCategoria" class="text-danger small"></span>
    <div class="form-text">
        <a asp-action="Categorias">Agregar nueva categoría</a>
    </div>
</div>

<div class="mb-3">
    <label asp-for="PrecioVenta" class="form-label"></label>
    <input asp-for="PrecioVenta" type="number" step="0.01" min="0.01" class="form-control" />
    <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
</div>

@if (Model.IdProducto > 0)
{
    <div class="mb-3">
        <label class="form-label">Stock disponible</label>
        <input class="form-control" value="@Model.StockDisponible" disabled />
        <div class="form-text">El stock se actualiza con las compras a proveedor y las ventas.</div>
    </div>
}

<div class="mb-3">
    <label asp-for="DiasAvisoVencimiento" class="form-label"></label>
    <input asp-for="DiasAvisoVencimiento" type="number" min="0" class="form-control" />
    <span asp-validation-for="DiasAvisoVencimiento" class="text-danger small"></span>
</div>
