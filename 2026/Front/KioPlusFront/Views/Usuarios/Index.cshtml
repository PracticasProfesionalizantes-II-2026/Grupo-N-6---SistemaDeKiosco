@model IReadOnlyList<UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
    var propio = Context.Session.ObtenerUsuario();
    var puntos = new string((char)0x25CF, 8);
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Usuarios</h1>
    <a class="btn btn-kp" asp-action="Crear">Agregar usuario</a>
</div>

@if (Model.Count == 0)
{
    <p class="kp-vacio">No hay usuarios cargados.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th style="width:90px"></th>
                    <th>Nombre y Apellido</th>
                    <th>Teléfono</th>
                    <th>Nombre de usuario</th>
                    <th>Contraseña</th>
                    <th>Tipo de usuario</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var esPropio = propio is not null && propio.IdUsuario == u.IdUsuario;
                    <tr>
                        <td>
                            <div class="kp-acciones">
                                <a class="kp-icon-btn" asp-action="Editar" asp-route-id="@u.IdUsuario" title="Editar">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 20h4l10-10-4-4L4 16z" />
                                        <path d="m14 6 4 4" />
                                    </svg>
                                </a>

                                @if (!esPropio)
                                {
                                    <form asp-action="Eliminar" method="post"
                                          onsubmit="return confirm('¿Eliminar al usuario @u.NombreApellido?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.IdUsuario" />
                                        <button type="submit" class="kp-icon-btn" title="Eliminar">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13" />
                                            </svg>
                                        </button>
                                    </form>

                                    <form asp-action="CambiarEstado" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.IdUsuario" />
                                        <input type="hidden" name="estado" value="@((!u.Estado).ToString().ToLower())" />
                                        <button type="submit" class="kp-icon-btn"
                                                title="@(u.Estado ? "Bloquear acceso" : "Habilitar acceso")">
                                            @if (u.Estado)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="5" y="11" width="14" height="9" rx="2" />
                                                    <path d="M8 11V7.5a4 4 0 0 1 8 0V11" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="5" y="11" width="14" height="9" rx="2" />
                                                    <path d="M8 11V7.5a4 4 0 0 1 7.7-1.5" />
                                                </svg>
                                            }
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                        <td>@u.NombreApellido</td>
                        <td>@u.Telefono</td>
                        <td>@u.NombreUsuario</td>
                        <td>
                            <span class="d-inline-flex align-items-center gap-2">
                                <span data-contrasenia="@u.ContraseniaUsuario">@puntos</span>
                                <button type="button" class="kp-icon-btn" title="Mostrar/ocultar contraseña"
                                        data-toggle-contrasenia>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z" />
                                        <circle cx="12" cy="12" r="2.6" />
                                    </svg>
                                </button>
                            </span>
                        </td>
                        <td>@u.TipoUsuario</td>
                        <td class="text-center">
                            <span class="kp-badge @(u.Estado ? "kp-badge-aldia" : "kp-badge-inactivo")">
                                @(u.Estado ? "Activo" : "Bloqueado")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        // Reproduce el ojito del mockup: alterna entre los puntos y la contraseña real.
        document.querySelectorAll('[data-toggle-contrasenia]').forEach(function (boton) {
            boton.addEventListener('click', function () {
                const celda = boton.parentElement.querySelector('[data-contrasenia]');
                const oculta = '●'.repeat(8);
                celda.textContent = celda.textContent === oculta
                    ? celda.dataset.contrasenia
                    : oculta;
            });
        });
    </script>
}
