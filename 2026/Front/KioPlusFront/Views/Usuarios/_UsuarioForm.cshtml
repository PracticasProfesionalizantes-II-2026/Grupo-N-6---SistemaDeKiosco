@using KioPlusFront.Services
@model UsuarioFormViewModel
@{
    // Solo el superadmin puede crear o editar usuarios administradores
    var esSuperAdmin = Context.Session.ObtenerUsuario()?.TipoUsuario == TipoDeUsuario.SuperAdmin;

    // El superadmin es único y viene con el sistema: no se puede crear otro.
    // La opción aparece únicamente al editar al que ya existe, para no degradarlo.
    var editandoAlSuperAdmin = Model.TipoUsuario == TipoDeUsuario.SuperAdmin && Model.IdUsuario > 0;
}

@Html.AntiForgeryToken()
<input type="hidden" asp-for="IdUsuario" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<div class="mb-3">
    <label asp-for="NombreApellido" class="form-label"></label>
    <input asp-for="NombreApellido" class="form-control" />
    <span asp-validation-for="NombreApellido" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" class="form-control" />
    <span asp-validation-for="Telefono" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="NombreUsuario" class="form-label"></label>
    <input asp-for="NombreUsuario" class="form-control" autocomplete="off" />
    <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="ContraseniaUsuario" class="form-label"></label>
    <div class="kp-clave">
            <input asp-for="ContraseniaUsuario" type="password" class="form-control"
                   autocomplete="new-password"
                   placeholder="@(Model.IdUsuario > 0 ? "Dejala vacía para no cambiarla" : "")" />
            <partial name="_OjoClave" model='"ContraseniaUsuario"' />
        </div>
    <span asp-validation-for="ContraseniaUsuario" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="TipoUsuario" class="form-label"></label>
    <select asp-for="TipoUsuario" class="form-select">
        @if (editandoAlSuperAdmin)
        {
            <option value="@TipoDeUsuario.SuperAdmin">SuperAdmin</option>
        }
        @if (esSuperAdmin)
        {
            <option value="@TipoDeUsuario.Administrador">Administrador</option>
        }
        <option value="@TipoDeUsuario.Empleado">Empleado</option>
    </select>
</div>

<div class="form-check mb-3">
    <input asp-for="Estado" class="form-check-input" type="checkbox" />
    <label asp-for="Estado" class="form-check-label"></label>
</div>
