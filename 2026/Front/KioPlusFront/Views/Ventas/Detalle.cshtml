@model IReadOnlyList<DetalleVentaListadoDto>
@{
    ViewData["Title"] = "Productos de la venta";
    var venta = ViewBag.Venta as VentaDto;
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Venta #@(venta?.IdVenta)</h1>
    <a class="btn btn-kp-outline" asp-action="Listado">Volver</a>
</div>

@if (venta is not null)
{
    <div class="kp-filtros">
        <div class="row">
            <div class="col-md-3"><strong>Fecha:</strong> @venta.FechaHora.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="col-md-3">
                <strong>Forma de pago:</strong>
                @(venta.FormaPago == FormaDePago.CuentaCorriente ? "Cuenta corriente" : "Pagado al momento")
            </div>
            <div class="col-md-3">
                <strong>Estado:</strong>
                @(venta.Estado == EstadoVenta.Pagado ? "Pagado" : "No pagado")
            </div>
            <div class="col-md-3"><strong>Total:</strong> $@venta.MontoTotal.ToString("N2")</div>
        </div>
    </div>
}

@if (Model.Count == 0)
{
    <p class="kp-vacio">Esta venta no tiene productos cargados.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio Unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model)
                {
                    <tr>
                        <td>@detalle.Producto</td>
                        <td class="text-center">@detalle.Cantidad</td>
                        <td class="text-end">$@detalle.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">$@detalle.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="kp-total">Total: $@Model.Sum(d => d.Subtotal).ToString("N2")</div>
}
