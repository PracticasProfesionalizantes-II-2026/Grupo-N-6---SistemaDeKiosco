@model NuevaVentaViewModel
@{
    ViewData["Title"] = "Nueva venta";
}

<div class="kp-page-header">
    <h1 class="kp-page-title">Nueva venta</h1>
    <a class="btn btn-kp" asp-controller="Stock" asp-action="CrearProducto"
       asp-route-volverA="@Url.Action("Nueva", "Ventas")">Nuevo Producto</a>
</div>

@* --- Alta de renglones --- *@
<form asp-action="AgregarItem" method="post" class="kp-filtros" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-3 align-items-end">
        <div class="col-md-7">
            <partial name="_Combo" model="Combos.Productos(Model.Productos, Model.IdProductoNuevo)" />
        </div>

        <div class="col-md-2">
            <label class="form-label" for="cantidad">Cantidad</label>
            <input class="form-control" type="number" id="cantidad" name="cantidad" min="1" value="1" required />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-kp w-100">Agregar</button>
        </div>
    </div>
</form>

@* --- Carrito --- *@
@if (Model.Items.Count == 0)
{
    <p class="kp-vacio">Todavía no cargaste productos en esta venta.</p>
}
else
{
    <div class="kp-table-wrapper">
        <table class="kp-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio Unitario</th>
                    <th class="text-end">Subtotal</th>
                    <th style="width:70px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Producto</td>
                        <td class="text-center">
                            @* La cantidad se corrige sin rehacer la venta *@
                            <form asp-action="ActualizarItem" method="post" class="kp-cantidad" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                <input class="form-control form-control-sm" type="number" name="cantidad"
                                       min="1" max="@Model.StockDisponible(item.IdProducto)"
                                       value="@item.Cantidad" aria-label="Cantidad de @item.Producto" />
                                <button type="submit" class="kp-icon-btn" title="Guardar la cantidad">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m5 13 4 4L19 7" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                        <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">$@item.Subtotal.ToString("N2")</td>
                        <td>
                            <form asp-action="QuitarItem" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                <button type="submit" class="kp-icon-btn" title="Quitar de la venta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="m9 9 6 6M15 9l-6 6" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="kp-total">Total: $@Model.Total.ToString("N2")</div>
}

@* --- Cierre de la venta --- *@
<form asp-action="Finalizar" method="post" class="mt-4" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-md-4">
            <label class="form-label" for="formaPago">Forma de pago</label>
            <select class="form-select" name="formaPago" id="formaPago">
                <option value="@FormaDePago.PagadoAlMomento">Pagado al momento</option>
                <option value="@FormaDePago.CuentaCorriente">Cuenta Corriente</option>
            </select>
        </div>

        <div class="col-md-8">
            <partial name="_Combo"
                     model="Combos.Clientes(Model.Clientes, Model.IdCliente, CuentaCorrienteService.IdConsumidorFinal)" />
            <div class="form-text">
                Una venta en cuenta corriente necesita un cliente registrado distinto de Consumidor final.
            </div>
        </div>
    </div>

    <div class="kp-form-acciones">
        <button type="submit" class="btn btn-kp-outline" formaction="@Url.Action("Cancelar")">
            Cancelar venta
        </button>
        <button type="submit" class="btn btn-kp">Finalizar venta</button>
    </div>
</form>
